package pages

import "github.com/MateuszPietrzak/72h/templates/components"

templ Script(child string) {
	<!DOCTYPE html>
	<html>
		<head>
			<title>72 Godziny</title>
			@components.StyleSetup()
		</head>
		<body>
			@components.Navbar()
			@components.ScriptsMenu()
			<div>
				@templ.Raw(child)
			</div>
		</body>
	</html>
}
